# SOC Data Sanitization Platform production settings
# Copy to /etc/sanitization-app/sanitization.env and restrict permissions.

SANIT_BIND=0.0.0.0:8443
SANIT_GUNICORN_WORKERS=1
SANIT_GUNICORN_THREADS=4
SANIT_GUNICORN_TIMEOUT=120
SANIT_GUNICORN_GRACEFUL_TIMEOUT=30
SANIT_GUNICORN_KEEPALIVE=5
SANIT_GUNICORN_MAX_REQUESTS=1000
SANIT_GUNICORN_MAX_REQUESTS_JITTER=100
SANIT_LOG_LEVEL=info

# Speed-oriented final package compression. 1 is fast with useful compression.
# Use 0 for maximum packaging speed or a higher value when package size matters more.
SANIT_ZIP_COMPRESSION_LEVEL=1

# Replace these with approved internal-CA files in production.
SANIT_TLS_CERT=/opt/sanitization-app/certs/cert.pem
SANIT_TLS_KEY=/opt/sanitization-app/certs/key.pem

# Session settings. The application creates a stable local key under data/
# when SANIT_SECRET_KEY is omitted. If supplied, use at least 32 random chars.
SANIT_SESSION_HOURS=8
SANIT_COOKIE_SECURE=1

SANIT_OUTPUT_RETENTION_DAYS=1
SANIT_HISTORY_RETENTION_DAYS=90
SANIT_MAX_EXTRACTED_MB=4096
SANIT_MAX_EXTRACTED_FILES=10000
SANIT_MAX_ARCHIVE_DEPTH=5
SANIT_ARCHIVE_TIMEOUT_SECONDS=300

# Offline OCR. Tesseract must be installed locally or supplied by an approved path.
# No cloud OCR service is used.
SANIT_REQUIRE_OCR=1
SANIT_OCR_LANG=eng
SANIT_OCR_DPI=200
SANIT_OCR_PSM=6
SANIT_OCR_MIN_CONFIDENCE=0
SANIT_OCR_TIMEOUT_SECONDS=120
SANIT_MAX_IMAGE_PIXELS=120000000
# SANIT_TESSERACT_BINARY=/usr/bin/tesseract
# SANIT_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# Makes the systemd preflight verifier refuse startup unless an enabled admin exists.
SANIT_REQUIRE_ADMIN=1
